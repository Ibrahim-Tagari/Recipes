<UserControl x:Class="PROG6221.POE.ST10062630.IngredientControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="450">
    <StackPanel Orientation="Horizontal">
        <TextBox x:Name="IngredientNameTextBox" Width="150" Margin="5" Text="Ingredient"/>
        <TextBox x:Name="IngredientQuantityTextBox" Width="50" Margin="5" Text="Qty"/>
        <TextBox x:Name="IngredientUnitTextBox" Width="50" Margin="5" Text="Unit"/>
        <TextBox x:Name="IngredientCaloriesTextBox" Width="50" Margin="5" Text="Calories"/>
        <ComboBox x:Name="FoodGroupComboBox" Width="100" Margin="5">
            <ComboBoxItem Content="None"/>
            <ComboBoxItem Content="Vegetable"/>
            <ComboBoxItem Content="Fruit"/>
            <ComboBoxItem Content="Grain"/>
            <ComboBoxItem Content="Dairy"/>
            <ComboBoxItem Content="Protein"/>
        </ComboBox>
    </StackPanel>
</UserControl>
