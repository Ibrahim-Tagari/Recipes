<Window x:Class="PROG6221.POE.ST10062630.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recipe App" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Menu">
                <MenuItem Header="Enter Recipe Details" Click="MenuEnterRecipeDetails_Click"/>
                <MenuItem Header="Display Recipe" Click="MenuDisplayRecipe_Click"/>
                <MenuItem Header="Scale Recipe" Click="MenuScaleRecipe_Click"/>
                <MenuItem Header="Reset Quantities" Click="MenuResetQuantities_Click"/>
                <MenuItem Header="Filter Recipe" Click="MenuFilterRecipe_Click"/>
                <MenuItem Header="Clear Data" Click="MenuClearData_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>
        <Grid Width="798">
            <TextBlock Text="CHEF'S COMPANION" Foreground="Black" FontSize="58" FontWeight="Bold" Margin="120,0,-120,0" />
            <TextBlock Text="All you need to keep track of your recipes !" Foreground="Black" FontSize="30" FontWeight="SemiBold" Margin="120,91,-120,-91"/>
            <Image Source="Images/ChefsCompanionLogo.jpg" Width="400" Height="250" Margin="199,156,199,10" />
        </Grid>
        <ContentControl x:Name="MainContent" />
    </DockPanel>
</Window>
