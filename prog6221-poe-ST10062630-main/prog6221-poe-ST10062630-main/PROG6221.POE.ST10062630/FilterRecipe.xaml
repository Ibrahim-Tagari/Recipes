<UserControl x:Class="PROG6221.POE.ST10062630.FilterRecipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Filter Recipes" FontSize="20" Margin="10"/>
            <TextBlock Text="Enter Ingredient:" Margin="10,5"/>
            <TextBox x:Name="IngredientFilter" Margin="10,5"/>
            <TextBlock Text="Select Food Group:" Margin="10,5"/>
            <ComboBox x:Name="FoodGroupFilter" Margin="10,5">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Vegetable"/>
                <ComboBoxItem Content="Fruit"/>
                <ComboBoxItem Content="Grain"/>
                <ComboBoxItem Content="Dairy"/>
                <ComboBoxItem Content="Protein"/>
            </ComboBox>
            <TextBlock Text="Enter Maximum Calories:" Margin="10,5"/>
            <TextBox x:Name="MaxCaloriesFilter" Margin="10,5"/>
            <Button Content="Apply Filter" Click="ApplyFilter_Click" Margin="10,5"/>
            <TextBlock x:Name="FilteredRecipes" TextWrapping="Wrap" Margin="10"/>
        </StackPanel>
    </Grid>
</UserControl>
